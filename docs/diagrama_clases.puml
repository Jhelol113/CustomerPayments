@startuml Diagrama_Clases_CustomerPayment

' ============================================================================
' DIAGRAMA DE CLASES — Customer-Payment CRUD System
' Arquitectura N-Tier con Stored Procedures
' ============================================================================

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontSize 11

skinparam class {
    BackgroundColor<<Entity>> #E8F5E9
    BackgroundColor<<DTO>> #E3F2FD
    BackgroundColor<<Interface>> #FFF3E0
    BackgroundColor<<Controller>> #FCE4EC
    BackgroundColor<<Service>> #F3E5F5
    BackgroundColor<<Repository>> #E0F7FA
    BackgroundColor<<Security>> #FFF9C4
    BackgroundColor<<Data>> #F5F5F5
    BorderColor #37474F
    FontColor #212121
}

' =============================================
' CAPA 1: ENTIDADES (Entities)
' =============================================
package "Entities" #E8F5E9 {

    class Customer <<Entity>> {
        + Id : int <<PK>>
        + Nombre : string
        + Email : string
        + Telefono : string?
        + Direccion : string?
        + FechaCreacion : DateTime
        + Activo : bool
        + Payments : ICollection<Payment>
    }

    class Payment <<Entity>> {
        + Id : int <<PK>>
        + CustomerId : int <<FK>>
        + Monto : decimal
        + MetodoPago : string
        + FechaPago : DateTime
        + Estado : string
        + FechaCreacion : DateTime
        + Customer : Customer
        + CustomerNombre : string? <<NotMapped>>
    }

    class User <<Entity>> {
        + Id : int <<PK>>
        + Username : string
        + PasswordHash : string
        + Rol : string
        + FechaCreacion : DateTime
        + Activo : bool
    }

    Customer "1" --> "0..*" Payment : tiene >
}

' =============================================
' CAPA 2: DTOs (Data Transfer Objects)
' =============================================
package "DTOs" #E3F2FD {

    package "DTOs.Customer" {
        class CustomerRequestDto <<DTO>> {
            + Nombre : string <<Required>>
            + Email : string <<Required, EmailAddress>>
            + Telefono : string?
            + Direccion : string?
        }

        class CustomerResponseDto <<DTO>> {
            + Id : int
            + Nombre : string
            + Email : string
            + Telefono : string?
            + Direccion : string?
            + FechaCreacion : DateTime
            + Activo : bool
        }
    }

    package "DTOs.Payment" {
        class PaymentRequestDto <<DTO>> {
            + CustomerId : int <<Required>>
            + Monto : decimal <<Required, Range(0.01, ∞)>>
            + MetodoPago : string <<Required>>
            + Estado : string?
        }

        class PaymentResponseDto <<DTO>> {
            + Id : int
            + CustomerId : int
            + Monto : decimal
            + MetodoPago : string
            + FechaPago : DateTime
            + Estado : string
            + FechaCreacion : DateTime
            + CustomerNombre : string?
        }

        class UpdatePaymentStatusDto <<DTO>> {
            + Estado : string <<Required>>
        }
    }

    package "DTOs.Auth" {
        class LoginRequestDto <<DTO>> {
            + Username : string <<Required>>
            + Password : string <<Required>>
        }

        class LoginResponseDto <<DTO>> {
            + Token : string
            + Username : string
            + Rol : string
            + Expiracion : DateTime
        }
    }
}

' =============================================
' CAPA 3: INTERFACES DE REPOSITORIO
' =============================================
package "Repositories.Interfaces" #FFF3E0 {

    interface ICustomerRepository <<Interface>> {
        + GetAllAsync() : Task<IEnumerable<Customer>>
        + GetByIdAsync(id : int) : Task<Customer?>
        + CreateAsync(customer : Customer) : Task<int>
        + UpdateAsync(customer : Customer) : Task<bool>
        + DeleteAsync(id : int) : Task<bool>
    }

    interface IPaymentRepository <<Interface>> {
        + GetAllAsync(customerId? : int) : Task<IEnumerable<Payment>>
        + GetByIdAsync(id : int) : Task<Payment?>
        + CreateAsync(payment : Payment) : Task<int>
        + UpdateAsync(payment : Payment) : Task<bool>
        + DeleteAsync(id : int) : Task<bool>
        + UpdateStatusAsync(id : int, estado : string) : Task<bool>
    }

    interface IUserRepository <<Interface>> {
        + GetByUsernameAsync(username : string) : Task<User?>
        + CreateAsync(user : User) : Task<int>
    }
}

' =============================================
' CAPA 4: IMPLEMENTACIONES DE REPOSITORIO
' =============================================
package "Repositories.Implementations" #E0F7FA {

    class CustomerRepository <<Repository>> {
        - _context : AppDbContext
        + GetAllAsync() : Task<IEnumerable<Customer>>
        + GetByIdAsync(id) : Task<Customer?>
        + CreateAsync(customer) : Task<int>
        + UpdateAsync(customer) : Task<bool>
        + DeleteAsync(id) : Task<bool>
        __ Ejecuta Stored Procedures __
        sp_Customer_GetAll
        sp_Customer_GetById
        sp_Customer_Create
        sp_Customer_Update
        sp_Customer_Delete
    }

    class PaymentRepository <<Repository>> {
        - _context : AppDbContext
        + GetAllAsync(customerId?) : Task<IEnumerable<Payment>>
        + GetByIdAsync(id) : Task<Payment?>
        + CreateAsync(payment) : Task<int>
        + UpdateAsync(payment) : Task<bool>
        + DeleteAsync(id) : Task<bool>
        + UpdateStatusAsync(id, estado) : Task<bool>
        __ Ejecuta Stored Procedures __
        sp_Payment_GetAll
        sp_Payment_GetById
        sp_Payment_Create
        sp_Payment_Update
        sp_Payment_Delete
        sp_Payment_UpdateStatus
    }

    class UserRepository <<Repository>> {
        - _context : AppDbContext
        + GetByUsernameAsync(username) : Task<User?>
        + CreateAsync(user) : Task<int>
        __ Ejecuta Stored Procedures __
        sp_User_GetByUsername
        sp_User_Create
    }
}

' =============================================
' CAPA 5: INTERFACES DE SERVICIO
' =============================================
package "Services.Interfaces" #FFF3E0 {

    interface ICustomerService <<Interface>> {
        + GetAllAsync() : Task<IEnumerable<CustomerResponseDto>>
        + GetByIdAsync(id : int) : Task<CustomerResponseDto?>
        + CreateAsync(dto : CustomerRequestDto) : Task<CustomerResponseDto>
        + UpdateAsync(id : int, dto : CustomerRequestDto) : Task<bool>
        + DeleteAsync(id : int) : Task<bool>
    }

    interface IPaymentService <<Interface>> {
        + GetAllAsync(customerId? : int) : Task<IEnumerable<PaymentResponseDto>>
        + GetByIdAsync(id : int) : Task<PaymentResponseDto?>
        + CreateAsync(dto : PaymentRequestDto) : Task<PaymentResponseDto>
        + UpdateAsync(id : int, dto : PaymentRequestDto) : Task<bool>
        + DeleteAsync(id : int) : Task<bool>
        + UpdateStatusAsync(id : int, estado : string) : Task<bool>
    }

    interface IAuthService <<Interface>> {
        + LoginAsync(dto : LoginRequestDto) : Task<LoginResponseDto?>
        + RegisterAsync(username, password, rol) : Task<bool>
    }
}

' =============================================
' CAPA 6: IMPLEMENTACIONES DE SERVICIO
' =============================================
package "Services.Implementations" #F3E5F5 {

    class CustomerService <<Service>> {
        - _customerRepository : ICustomerRepository
        - _paymentRepository : IPaymentRepository
        + GetAllAsync() : Task<IEnumerable<CustomerResponseDto>>
        + GetByIdAsync(id) : Task<CustomerResponseDto?>
        + CreateAsync(dto) : Task<CustomerResponseDto>
        + UpdateAsync(id, dto) : Task<bool>
        + DeleteAsync(id) : Task<bool>
        __ Regla de Negocio __
        Valida pagos Pendientes
        antes de Soft Delete
    }

    class PaymentService <<Service>> {
        - _paymentRepository : IPaymentRepository
        - _customerRepository : ICustomerRepository
        + GetAllAsync(customerId?) : Task<IEnumerable<PaymentResponseDto>>
        + GetByIdAsync(id) : Task<PaymentResponseDto?>
        + CreateAsync(dto) : Task<PaymentResponseDto>
        + UpdateAsync(id, dto) : Task<bool>
        + DeleteAsync(id) : Task<bool>
        + UpdateStatusAsync(id, estado) : Task<bool>
        __ Validación Cruzada __
        Verifica que CustomerId exista
    }

    class AuthService <<Service>> {
        - _userRepository : IUserRepository
        - _jwtHelper : JwtHelper
        + LoginAsync(dto) : Task<LoginResponseDto?>
        + RegisterAsync(username, password, rol) : Task<bool>
        __ Seguridad __
        BCrypt.Verify para Login
        BCrypt.HashPassword para Registro
    }
}

' =============================================
' CAPA 7: CONTROLLERS (API REST)
' =============================================
package "Controllers" #FCE4EC {

    class CustomerController <<Controller>> {
        - _customerService : ICustomerService
        + GetAll() : Task<IActionResult>
        + GetById(id) : Task<IActionResult>
        + Create(dto) : Task<IActionResult>
        + Update(id, dto) : Task<IActionResult>
        + Delete(id) : Task<IActionResult>
        __ Rutas HTTP __
        GET    /api/customers
        GET    /api/customers/{id}
        POST   /api/customers
        PUT    /api/customers/{id}
        DELETE /api/customers/{id}
    }

    class PaymentController <<Controller>> {
        - _paymentService : IPaymentService
        + GetAll(customerId?) : Task<IActionResult>
        + GetById(id) : Task<IActionResult>
        + Create(dto) : Task<IActionResult>
        + Update(id, dto) : Task<IActionResult>
        + Delete(id) : Task<IActionResult>
        + UpdateStatus(id, dto) : Task<IActionResult>
        __ Rutas HTTP __
        GET    /api/payments
        GET    /api/payments/{id}
        POST   /api/payments
        PUT    /api/payments/{id}
        DELETE /api/payments/{id}
        PATCH  /api/payments/{id}/status
    }

    class AuthController <<Controller>> {
        - _authService : IAuthService
        + Login(dto) : Task<IActionResult>
        + Register(dto, rol) : Task<IActionResult>
        __ Rutas HTTP __
        POST /api/auth/login
        POST /api/auth/register
    }
}

' =============================================
' INFRAESTRUCTURA
' =============================================
package "Data" #F5F5F5 {
    class AppDbContext <<Data>> {
        + Customers : DbSet<Customer>
        + Payments : DbSet<Payment>
        + Users : DbSet<User>
        # OnModelCreating(modelBuilder)
        __ Configuración __
        Relación 1:N Customer→Payment
        Ignore(CustomerNombre)
        Usa FromSqlRaw para SPs
    }
}

package "Security" #FFF9C4 {
    class JwtHelper <<Security>> {
        - _configuration : IConfiguration
        + GenerateToken(user : User) : string
        __ Configuración JWT __
        SecretKey, Issuer, Audience
        ExpirationMinutes
    }

    class SecurityHeadersMiddleware <<Security>> {
        + InvokeAsync(context) : Task
        __ Headers OWASP __
        X-Content-Type-Options
        X-Frame-Options
        X-XSS-Protection
        Content-Security-Policy
    }
}

' =============================================
' RELACIONES DE DEPENDENCIA (Inyección)
' =============================================

' Controllers → Services
CustomerController --> ICustomerService : usa >
PaymentController --> IPaymentService : usa >
AuthController --> IAuthService : usa >

' Services → Repositories
CustomerService ..|> ICustomerService
CustomerService --> ICustomerRepository : usa >
CustomerService --> IPaymentRepository : valida pagos >

PaymentService ..|> IPaymentService
PaymentService --> IPaymentRepository : usa >
PaymentService --> ICustomerRepository : valida cliente >

AuthService ..|> IAuthService
AuthService --> IUserRepository : usa >
AuthService --> JwtHelper : genera token >

' Repositories implementan interfaces
CustomerRepository ..|> ICustomerRepository
PaymentRepository ..|> IPaymentRepository
UserRepository ..|> IUserRepository

' Repositories → DbContext
CustomerRepository --> AppDbContext : usa >
PaymentRepository --> AppDbContext : usa >
UserRepository --> AppDbContext : usa >

@enduml
